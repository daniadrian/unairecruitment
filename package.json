{
    "name": "unairecruitment",
    "version": "0.1.0",
    "private": true,
    "description": "UNAI Recruitment - membership applicant management system",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:integration": "vitest run --config vitest.integration.config.mts",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:seed": "prisma db seed",
        "db:seed:recruitments": "tsx scripts/seedRecruitments.ts",
        "db:check": "tsx scripts/checkConnection.ts",
        "storage:setup": "tsx scripts/setupStorage.ts",
        "storage:check": "tsx scripts/checkStorage.ts",
        "smtp:check": "tsx scripts/checkSmtp.ts",
        "audit:layers": "node scripts/auditLayers.mjs",
        "verify": "npm run typecheck && npm run lint && npm run audit:layers && npm test"
    },
    "dependencies": {
        "@node-rs/argon2": "2.2.1",
        "@prisma/adapter-pg": "7.10.0",
        "@prisma/client": "7.10.0",
        "@supabase/supabase-js": "2.116.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "input-otp": "1.5.0",
        "lucide-react": "1.47.0",
        "next": "16.3.5",
        "nodemailer": "10.0.10",
        "pg": "8.23.0",
        "radix-ui": "1.6.7",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-is": "19.3.0",
        "recharts": "3.10.1",
        "tailwind-merge": "3.7.0",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.3.3",
        "@types/node": "24.13.6",
        "@types/nodemailer": "8.0.2",
        "@types/pg": "8.23.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "dotenv": "18.0.1",
        "eslint": "9.39.5",
        "eslint-config-next": "16.3.5",
        "prettier": "3.9.8",
        "prisma": "7.10.0",
        "tailwindcss": "4.3.3",
        "tsx": "4.23.15",
        "typescript": "5.9.3",
        "typescript-eslint": "8.70.0",
        "vitest": "4.1.11"
    }
}
